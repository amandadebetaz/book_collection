<h1>Book Collection</h1>

<% if notice %>
	<p><%= notice %></p>
<% end %>

<p>
	<%= link_to "Add a Book", new_book_path %>
</p>

<table style="border-collapse: collapse; width: 100%;">
	<thead>
		<tr>
			<th style="text-align: left; padding: 10px; border: 1px solid #ccc;">Title</th>
			<th style="text-align: left; padding: 10px; border: 1px solid #ccc;">Author</th>
			<th style="text-align: left; padding: 10px; border: 1px solid #ccc;">Price</th>
			<th style="text-align: left; padding: 10px; border: 1px solid #ccc;">Published Date</th>
			<th style="text-align: left; padding: 10px; border: 1px solid #ccc;">Actions</th>
		</tr>
	</thead>

	<tbody>
		<% @books.each do |book| %>
			<tr>
				<td style="padding: 10px; border: 1px solid #ccc;"><%= book.title %></td>
				<td style="padding: 10px; border: 1px solid #ccc;"><%= book.author %></td>
				<td style="padding: 10px; border: 1px solid #ccc;"><%= book.price %></td>
				<td style="padding: 10px; border: 1px solid #ccc;"><%= book.published_date %></td>
				<td style="padding: 10px; border: 1px solid #ccc;">
					<%= link_to "Show", book_path(book) %>
					<%= link_to "Edit", edit_book_path(book) %>
					<%= link_to "Delete", delete_book_path(book) %>
				</td>
			</tr>
		<% end %>
	</tbody>
</table>

<p>
	<%= link_to "Back to User Books", user_books_path %>
</p>