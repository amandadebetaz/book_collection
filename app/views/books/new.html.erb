<h1>Add a Book</h1>

<% if alert %>
    <p><%= alert %></p>
<% end %>

<%= form_with model: @book do |f| %>

    <div>
        <%= f.label :title %>
        <%= f.text_field :title %>
    </div><br />

    <div>
        <%= f.label :author %>
        <%= f.text_field :author %>
    </div>

    <div>
        <%= f.label :price %>
        <%= f.number_field :price, step: 0.01 %>
    </div>

    <div>
        <%= f.label :published_date %>
        <%= f.date_select :published_date %>
    </div>

    <div>
        <%= f.submit "Add Book" %>
    </div>

<% end %>

<p><%= link_to "Back to Home", root_path %></p>